# ===== LightAgent backend env template =====
# 复制为 .env 后修改

# --- App ---
APP_NAME=LightAgent
ENV=dev
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-32-byte-string-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# 本地快速启动（默认）: sqlite+aiosqlite:///./data/lightagent.db
# 生产 / Docker: postgresql+asyncpg://lightagent:lightagent@postgres:5432/lightagent
DATABASE_URL=sqlite+aiosqlite:///./data/lightagent.db

# --- Redis（可选，未配置时后台任务走进程内调度）---
REDIS_URL=

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- LLM ---
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Security ---
SSRF_ALLOW_PRIVATE=false
